#!/bin/bashARCHIVO="/etc/ADMRufu/acceso.valido"if [[ "$1" == "-r" ]]; then    rm -f "$ARCHIVO"    echo "Validacion reiniciada"    exit 0fiif [[ -f "$ARCHIVO" ]]; then    exit 0ficlearecho "============================================"echo "        PRIMERA CONFIGURACION"echo "============================================"read -p " INGRESAR CLAVE: " CLAVEif [[ "$CLAVE" == "fenix" ]]; then    echo "OK" > "$ARCHIVO"    chmod 600 "$ARCHIVO"    echo ""    echo " CLAVE CORRECTA"    echo " NO SE PEDIRA NUNCA MAS"    sleep 2    exit 0else    echo ""    echo " CLAVE INCORRECTA"    sleep 2    exit 1fi